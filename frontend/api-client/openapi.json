              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Current user",
        "description": "The authenticated user's account, whatever its status. Creates the account on first visit when signups allow it.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The caller's account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
