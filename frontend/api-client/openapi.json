  "components": {
    "schemas": {
      "AdminUserList": {
        "type": "object",
        "required": [
          "users",
          "counts"
        ],
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/StatusCounts"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserView"
            }
          }
