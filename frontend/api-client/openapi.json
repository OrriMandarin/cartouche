{
  "openapi": "3.1.0",
  "info": {
    "title": "Cartouche API",
    "description": "Cartouche public HTTP API. Errors are always `{\"error\":{\"code\",\"message\",\"request_id\"}}`.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List accounts",
        "description": "Lists accounts, newest first, optionally filtered by status, with the number of accounts per status.",
        "operationId": "list_users",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Only accounts in this status.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accounts and per-status counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserList"
                }
              }
            }
          },
          "400": {
            "description": "Unknown `status` filter (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an approved administrator (`forbidden`, `account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{id}/status": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Change an account's status",
        "description": "Changes an account's status and records it in the audit log. Administrators cannot be moderated, and only allowed transitions succeed.",
        "operationId": "set_user_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the account to moderate.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStatusBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The account with its new status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserView"
                }
              }
            }
          },
          "400": {
            "description": "Malformed id or body (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an approved administrator, or the target is an administrator (`forbidden`, `cannot_moderate_admin`, `account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such account (`not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The status change is not an allowed transition (`invalid_transition`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "description": "Reports whether the API and its database are up.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The API and its database are up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "Current user",
        "description": "The authenticated user's account, whatever its status. Creates the account on first visit when signups allow it.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The caller's account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "Signups are closed for a new user (`signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminUserList": {
        "type": "object",
        "required": [
          "users",
          "counts"
        ],
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/StatusCounts"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminUserView"
            }
          }
        }
      },
      "AdminUserView": {
        "type": "object",
        "description": "An account as seen by an administrator.",
        "required": [
          "id",
          "subject",
          "status",
          "is_admin",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_admin": {
            "type": "boolean",
            "description": "Evaluated from `ADMIN_USER_IDS`, never stored."
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Body of every error response: `{\"error\":{\"code\",\"message\",\"request_id\"}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, snake_case (e.g. `account_pending`)."
          },
          "message": {
            "type": "string",
            "description": "Human-readable English explanation; clients should switch on `code`."
          },
          "request_id": {
            "type": "string",
            "description": "Id of the failed request, also sent in the `x-request-id` response header."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Liveness and database reachability.",
        "required": [
          "status",
          "db"
        ],
        "properties": {
          "db": {
            "type": "string",
            "description": "`ok`, or `error` when the database is unreachable.",
            "example": "ok"
          },
          "status": {
            "type": "string",
            "description": "`ok`, or `degraded` when the database is unreachable.",
            "example": "ok"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "The authenticated user's account.",
        "required": [
          "id",
          "status",
          "is_admin"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_admin": {
            "type": "boolean",
            "description": "Evaluated from `ADMIN_USER_IDS`, never stored."
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        }
      },
      "SetStatusBody": {
        "type": "object",
        "description": "The status to move an account to.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        }
      },
      "StatusCounts": {
        "type": "object",
        "description": "Number of accounts per status; all four are always present.",
        "required": [
          "pending",
          "approved",
          "rejected",
          "suspended"
        ],
        "properties": {
          "approved": {
            "type": "integer",
            "format": "int64"
          },
          "pending": {
            "type": "integer",
            "format": "int64"
          },
          "rejected": {
            "type": "integer",
            "format": "int64"
          },
          "suspended": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "rejected",
          "suspended"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token issued by the identity provider."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Service health"
    },
    {
      "name": "account",
      "description": "The signed-in user's account"
    },
    {
      "name": "admin",
      "description": "Support tools, administrators only"
    }
  ]
}
