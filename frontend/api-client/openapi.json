{
  "openapi": "3.1.0",
  "info": {
    "title": "Cartouche API",
    "description": "Cartouche public HTTP API. Errors are always `{\"error\":{\"code\",\"message\",\"request_id\"}}`.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/users": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List accounts",
        "description": "Lists accounts, newest first, optionally filtered by status, with the number of accounts per status.",
        "operationId": "list_users",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Only accounts in this status.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/UserStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accounts and per-status counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserList"
                }
              }
            }
          },
          "400": {
            "description": "Unknown `status` filter (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an approved administrator (`forbidden`, `account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{id}/status": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Change an account's status",
        "description": "Changes an account's status and records it in the audit log. Administrators cannot be moderated, and only allowed transitions succeed.",
        "operationId": "set_user_status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the account to moderate.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStatusBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The account with its new status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminUserView"
                }
              }
            }
          },
          "400": {
            "description": "Malformed id or body (`invalid_request`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller is not an approved administrator, or the target is an administrator (`forbidden`, `cannot_moderate_admin`, `account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such account (`not_found`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The status change is not an allowed transition (`invalid_transition`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/cards": {
      "get": {
        "tags": [
          "cards"
        ],
        "summary": "List my cards",
        "description": "The caller's cards, oldest first. Other users' cards are never listed.",
        "operationId": "list_cards",
        "responses": {
          "200": {
            "description": "The caller's cards.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller's account is not approved (`account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "cards"
        ],
        "summary": "Create a card",
        "description": "Creates a card with the default template and theme, and claims its slug.",
        "operationId": "create_card",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCardBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "The new card.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardView"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body (`invalid_request`) or invalid fields (`validation_failed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_invalid`, `token_expired`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The caller's account is not approved (`account_pending`, `account_rejected`, `account_suspended`, `signup_closed`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The slug is not available (`slug_taken`, `slug_reserved`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure (`internal_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider is unreachable (`auth_unavailable`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/cards/{id}": {
      "get": {
        "tags": [
          "cards"
        ],
        "summary": "Get a card",
        "description": "One of the caller's cards. A card of another user is reported as not found.",
        "operationId": "get_card",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id of the card.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The card.",
