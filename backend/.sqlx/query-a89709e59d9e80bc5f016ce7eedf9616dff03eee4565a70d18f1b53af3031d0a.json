  "query": "select s.is_current, cur.slug as current_slug, c.id, c.owner_id, c.template, c.settings, c.theme, c.first_name, c.last_name, c.job_title, c.company, c.description, c.email, c.phone, c.links, c.header_media_id, c.avatar_media_id, c.owner_disabled_at, c.support_disabled_at, c.created_at, c.updated_at, u.status as owner_status from card_slugs s left join cards c on c.id = s.card_id left join card_slugs cur on cur.card_id = c.id and cur.is_current left join users u on u.id = c.owner_id where s.slug = $1",
