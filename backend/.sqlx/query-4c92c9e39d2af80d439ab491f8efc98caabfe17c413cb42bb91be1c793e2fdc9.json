  "query": "select l.id, l.event_id, e.title as event_title, l.device_id, l.submitted_at, l.first_name, l.last_name, l.birth_date, l.email, l.phone, l.street, l.postal_code, l.city, l.country, l.custom_answers, l.consent_at, l.consent_text, l.spam_at from leads l join events e on e.id = l.event_id join cards c on c.id = e.card_id where c.id = $1 and c.owner_id = $2 order by l.submitted_at desc, l.id desc",
