  "query": "select c.id, c.owner_id, s.slug, c.template, c.settings, c.theme, c.first_name, c.last_name, c.job_title, c.company, c.description, c.email, c.phone, c.links, c.header_media_id, c.avatar_media_id, c.owner_disabled_at, c.support_disabled_at, c.created_at, c.updated_at from cards c join card_slugs s on s.card_id = c.id and s.is_current where c.owner_id = $1 and ($2::uuid is null or c.id = $2) order by c.created_at, c.id",
