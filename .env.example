# Cartouche - variables d'environnement.
# Copiez ce fichier en `.env` pour surcharger les valeurs par defaut du Makefile.
# Les valeurs ci-dessous permettent de developper en local SANS Clerk
# (fournisseur d'authentification de test, JWKS servi par l'API elle-meme).
# Attention : le Makefile lit ce fichier tel quel, n'utilisez pas de guillemets.
# Les variables optionnelles sont commentees : une variable vide serait exportee vide.

# --- API (backend) ---

# Environnement d'execution : development | test | production.
# Absent ou invalide = production. En production, les routes de test
# (/api/test/*) sont absentes et l'emetteur de test est refuse.
APP_ENV=development

# URL de connexion PostgreSQL (base fournie par `make dev-db`, port 54320).
DATABASE_URL=postgres://cartouche:cartouche@localhost:54320/cartouche

# Adresse et port d'ecoute de l'API.
BIND_ADDR=127.0.0.1:8080

# URL publique du site (utilisee pour construire les liens et les QR codes).
PUBLIC_BASE_URL=http://localhost:3000

# Emetteur (claim `iss`) attendu dans les jetons JWT.
# En dev sans Clerk : l'emetteur de test integre a l'API.
AUTH_ISSUER=cartouche-test-issuer

# URL du JWKS servant a verifier les signatures des jetons.
# En dev sans Clerk : le JWKS de test expose par l'API.
AUTH_JWKS_URL=http://localhost:8080/api/test/jwks.json

# Audience (claim `aud`) attendue dans les jetons (optionnel, a decommenter si besoin).
# AUTH_AUDIENCE=

# Identifiants (separes par des virgules) des utilisateurs administrateurs.
ADMIN_USER_IDS=seed-admin

# Mode d'inscription : open (compte approuve d'office) | approval (en attente
# de validation par un administrateur, defaut) | closed (inscriptions refusees).
SIGNUP_MODE=approval

# Nombre de reverse proxies de confiance devant l'API (1 par defaut) : l'adresse
# retenue pour limiter les envois est la n-ieme de X-Forwarded-For en partant de la
# droite. 1 derriere Caddy, 0 si l'API est exposee directement. Entier de 0 a 10.
# TRUSTED_PROXY_HOPS=1

# Nombre maximal d'evenements simultanes par carte, 3 par defaut. Entier d'au moins 1.
# MAX_SIMULTANEOUS_EVENTS=3

# DSN Sentry cote API (optionnel). Sentry reste desactive tant qu'il est absent.
# SENTRY_DSN=

# --- Medias (photos et videos des cartes) ---

# Stockage des medias : local (disque de l'API, defaut) | s3 (stockage compatible S3).
# En mode local, l'API sert elle-meme /media/*. En mode s3, les medias sont
# servis par MEDIA_PUBLIC_BASE_URL et /media/* n'est pas monte.
# MEDIA_STORAGE=local

# Dossier des medias en mode local (cree au demarrage). Defaut : ./data/media.
# Le Makefile le fixe a .data/media a la racine du depot.
# MEDIA_LOCAL_DIR=./data/media

# Mode s3 uniquement : bucket, region et identifiants d'acces (secret : ne jamais commiter).
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=

# Mode s3 uniquement : point d'acces d'un service compatible S3 (MinIO, R2...).
# Absent = AWS S3.
# MEDIA_S3_ENDPOINT=

# Mode s3 uniquement (obligatoire) : adresse publique du bucket, sans "/" final.
# Les medias sont servis a {MEDIA_PUBLIC_BASE_URL}/cards/....
# MEDIA_PUBLIC_BASE_URL=

# --- Web (frontend/web) ---

# Profil de build : development | test | production (defaut : production).
# L'adaptateur d'authentification `test` est interdit avec le profil production.
CARTOUCHE_BUILD_PROFILE=development

# Fournisseur d'authentification : test | clerk | oidc.
NEXT_PUBLIC_AUTH_PROVIDER=test

# Cles Clerk (uniquement si NEXT_PUBLIC_AUTH_PROVIDER=clerk).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Parametres OIDC generique (uniquement si NEXT_PUBLIC_AUTH_PROVIDER=oidc).
# NEXT_PUBLIC_OIDC_AUTHORITY=
# NEXT_PUBLIC_OIDC_CLIENT_ID=

# URL interne de l'API, utilisee par le serveur Next.js (et non par le navigateur).
API_INTERNAL_URL=http://localhost:8080

# DSN Sentry cote navigateur (optionnel). Sentry reste desactive tant qu'il est absent.
# NEXT_PUBLIC_SENTRY_DSN=

# Points de contact de l'instance (ADM-021). Les valeurs par defaut sont des
# substituts qu'une instance de production remplace ; une variable vide vaut absente.
# Adresse du support (liens "Contacter le support").
# NEXT_PUBLIC_SUPPORT_EMAIL=support@cartouche.invalid
# Adresse des conditions generales d'utilisation.
# NEXT_PUBLIC_TERMS_URL=/cgu
# Adresse de la politique de confidentialite (lien "Vos donnees personnelles" du formulaire).
# NEXT_PUBLIC_PRIVACY_URL=/confidentialite
